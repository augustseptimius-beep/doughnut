# Kopiér til .env og indsæt din egen nøgle. .env er git-ignoreret.
#
# Navnet skal matche det Netlify-funktionen læser i
# netlify/functions/klimaregnskabet.mts. Den tidligere committede .env brugte
# KLIMAREGNSKAB_API_KEY (uden ET), som funktionen aldrig ville finde.
#
# I produktion sættes variablen i Netlify under Site settings > Environment
# variables, ikke i en fil.
KLIMAREGNSKABET_API_KEY=
